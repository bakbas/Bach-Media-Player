{
  "name": "@bach/tailwind",
  "version": "0.0.0",
  "description": "Tailwind preset plugin exposing the Bach Media Player CSS variable contract as Tailwind theme tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "@bach/core": "workspace:*",
    "tailwindcss": "^3.4.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": { "optional": true }
  },
  "devDependencies": {
    "@bach/core": "workspace:*"
  },
  "size-limit": [
    {
      "name": "@bach/tailwind (ESM, gzipped)",
      "path": "dist/index.js",
      "limit": "2 KB"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
