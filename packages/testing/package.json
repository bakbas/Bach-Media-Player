{
  "name": "@bach/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Internal-only mocks and fixtures for Bach Media Player tests: MSE, EME, WebCodecs, HTMLMediaElement extras, conduct WebSocket, synthetic HLS playlists.",
