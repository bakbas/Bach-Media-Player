      "types": "./src/synthetic-hls.ts",
      "import": "./src/synthetic-hls.ts"
    }
  },
  "scripts": {
    "build": "echo 'internal package — source-only'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  }
}
